#Introduction (Markdown)# EDA & Fraud Detection Notebook#This notebook performs Exploratory Data Analysis (EDA) and builds fraud detection models on the `bank_transactions_data_2.csv` dataset.We:- Explore transaction patterns and customer behavior- Create a synthetic `FraudFlag` based on business rules- Preprocess features- Train multiple classification models- Compare their performanceimport pandas as pdimport numpy as npimport matplotlib.pyplot as pltfrom sklearn.ensemble import RandomForestClassifierfrom sklearn.tree import plot_tree, DecisionTreeClassifierfrom sklearn.model_selection import train_test_splitfrom sklearn.linear_model import LogisticRegressionfrom sklearn.neighbors import KNeighborsClassifierfrom sklearn.svm import SVCfrom sklearn.preprocessing import StandardScalerfrom sklearn.ensemble import VotingClassifier, BaggingClassifierfrom sklearn.pipeline import Pipelineimport warningswarnings.filterwarnings('ignore')plt.style.use('seaborn-v0_8')# Adjust path if neededdf = pd.read_csv("bank_transactions_data_2.csv")df.head()print("Shape:", df.shape, "\n")print("Info:")print(df.info(), "\n")print("Describe (numeric):")print(df.describe(), "\n")print("Missing values per column:")print(df.isnull().sum())# Histograms for numeric columnsnumeric_cols = df.select_dtypes(include=[np.number]).columnsdf[numeric_cols].hist(figsize=(14, 10), bins=30)plt.tight_layout()plt.show()# Boxplots for numeric columnsplt.figure(figsize=(14, 8))df[numeric_cols].boxplot()plt.xticks(rotation=90)plt.tight_layout()plt.show()# Correlation heatmapcorr = df[numeric_cols].corr()plt.figure(figsize=(12, 10))plt.imshow(corr, cmap='coolwarm', interpolation='nearest')plt.colorbar()plt.xticks(range(len(corr.columns)), corr.columns, rotation=90)plt.yticks(range(len(corr.columns)), corr.columns)plt.title("Correlation Heatmap")plt.tight_layout()plt.show()# Ensure datetime typesdf['TransactionDate'] = pd.to_datetime(df['TransactionDate'])df['PreviousTransactionDate'] = pd.to_datetime(df['PreviousTransactionDate'])# Sort by AccountID and TransactionDate to compute time differencesdf = df.sort_values(['AccountID', 'TransactionDate'])# Time difference between current and previous transaction for same accountdf['time_diff_sec'] = (df['TransactionDate'] - df['PreviousTransactionDate']).dt.total_seconds()# 1) Credit followed by immediate Debit (short time difference)# We'll approximate "immediate" as <= 300 seconds (5 minutes)credit_mask = df['TransactionType'] == 'Credit'debit_mask = df['TransactionType'] == 'Debit'immediate_mask = df['time_diff_sec'].between(0, 300, inclusive='both')credit_to_debit_pattern = credit_mask & immediate_mask  # previous was credit, now close in time# 2) Suspicious location (non-US) Ð dataset uses US cities, so we treat all as US.# To honor your rule, we'll mark "non-US" as locations not in a known list.us_cities = [    "San Diego","Houston","Mesa","Raleigh","Atlanta","Oklahoma City","Seattle","Indianapolis",    "Detroit","Nashville","Albuquerque","Memphis","Miami","Milwaukee","Las Vegas","New York",    "San Francisco","Chicago","Denver","Dallas","San Jose","San Antonio","Philadelphia",    "Boston","Jacksonville","Sacramento","Washington","Portland","Colorado Springs","El Paso",    "Virginia Beach","Baltimore","Phoenix","Fort Worth","Kansas City","Fresno","Charlotte",    "Tucson","Omaha","Columbus","Louisville"]suspicious_location = ~df['Location'].isin(us_cities)# 3) Suspicious IP Ð simple heuristic: IP not starting with typical US blocksdef is_us_ip(ip):    first_octet = int(str(ip).split('.')[0])    us_blocks = {3,4,6,7,11,12,13,15,16,17,18,20,23,24,26,28,32,33,34,35,38,                 40,44,47,52,54,56,63,64,65,66,67,68,69,70,71,72,73,74,75,76,                 96,97,98,99}    return first_octet in us_blocksdf['is_us_ip'] = df['IP Address'].apply(is_us_ip)suspicious_ip = ~df['is_us_ip']# 4) Age between 20 and 35age_mask = df['CustomerAge'].between(20, 35, inclusive='both')# 5) High login attemptslogin_mask = df['LoginAttempts'] > 3# 6) Short transaction duration (< 30 seconds)duration_mask = df['TransactionDuration'] < 30# Combined fraud rulefraud_mask = (    credit_to_debit_pattern &    suspicious_location &    suspicious_ip &    age_mask &    login_mask &    duration_mask)df['FraudFlag'] = fraud_mask.astype(int)df[['TransactionID','AccountID','TransactionType','Location','IP Address',    'CustomerAge','LoginAttempts','TransactionDuration','FraudFlag']].head(20)print("FraudFlag value counts:")print(df['FraudFlag'].value_counts())fraud_rate = df['FraudFlag'].mean()print(f"\nApproximate fraud rate: {fraud_rate:.4f}")# Drop columns that are IDs or raw text not directly useful for modelingdrop_cols = [    'TransactionID',    'IP Address',    'DeviceID',    'PreviousTransactionDate',    'TransactionDate',    'is_us_ip']df_model = df.drop(columns=drop_cols)# Separate features and targetX = df_model.drop(columns=['FraudFlag'])y = df_model['FraudFlag']# Identify categorical columnscat_cols = X.select_dtypes(include=['object']).columnsnum_cols = X.select_dtypes(include=[np.number]).columnsprint("Categorical columns:", list(cat_cols))print("Numeric columns:", list(num_cols))# One-hot encode categorical variablesX_encoded = pd.get_dummies(X, columns=cat_cols, drop_first=True)print("Encoded shape:", X_encoded.shape)# Train/test splitX_train, X_test, y_train, y_test = train_test_split(    X_encoded, y, test_size=0.3, random_state=42, stratify=y)models = {}# Logistic Regressionmodels['LogisticRegression'] = Pipeline([    ('scaler', StandardScaler()),    ('clf', LogisticRegression(max_iter=1000))])# K-Nearest Neighborsmodels['KNN'] = Pipeline([    ('scaler', StandardScaler()),    ('clf', KNeighborsClassifier(n_neighbors=5))])# Support Vector Classifiermodels['SVC'] = Pipeline([    ('scaler', StandardScaler()),    ('clf', SVC(kernel='rbf', probability=True))])# Random Forestmodels['RandomForest'] = RandomForestClassifier(    n_estimators=200,    random_state=42,    class_weight='balanced')# Decision Treemodels['DecisionTree'] = DecisionTreeClassifier(    max_depth=None,    random_state=42,    class_weight='balanced')# Bagging (with Decision Tree base)base_dt = DecisionTreeClassifier(random_state=42)models['Bagging'] = BaggingClassifier(    base_estimator=base_dt,    n_estimators=50,    random_state=42)# Voting Classifier (soft voting)models['Voting'] = VotingClassifier(    estimators=[        ('lr', models['LogisticRegression']),        ('rf', models['RandomForest']),        ('svc', models['SVC'])    ],    voting='soft')from sklearn.metrics import accuracy_score, classification_reportresults = {}for name, model in models.items():    print(f"\nTraining {name}...")    model.fit(X_train, y_train)    y_pred = model.predict(X_test)    acc = accuracy_score(y_test, y_pred)    results[name] = acc    print(f"{name} Accuracy: {acc:.4f}")    print(classification_report(y_test, y_pred, digits=4))print("\nModel accuracy summary:")for name, acc in results.items():    print(f"{name}: {acc:.4f}")# Plot one tree from the RandomForest (for interpretability)rf = models['RandomForest']rf.fit(X_train, y_train)plt.figure(figsize=(18, 10))plot_tree(    rf.estimators_[0],    max_depth=3,    feature_names=X_encoded.columns,    class_names=['Not Fraud', 'Fraud'],    filled=True,    fontsize=8)plt.title("RandomForest - Example Tree (Depth 3)")plt.show()## ConclusionIn this notebook, we:- Performed EDA on bank transaction data- Engineered a synthetic `FraudFlag` based on business rules:  - Credit followed by immediate Debit  - Non-US location and IP  - Age between 20Ð35  - High login attempts  - Short transaction duration- Encoded categorical features and built multiple classification models- Compared model performance using accuracy and classification reportsThis framework can be extended with:- More realistic fraud labels- Better IP geolocation- Time-series features- Cost-sensitive learning and ROC/PR analysis